# Keep line endings stable on Windows checkouts.
* text=auto
# Bash scripts and Husky hooks must keep LF to run.
*.sh text eol=lf
.husky/* text eol=lf
# The sample-data loaders upload these with --line-ending LF (Bulk API), on every OS.
*.csv text eol=lf
# PowerShell scripts: CRLF is the Windows convention; PowerShell reads either.
*.ps1 text eol=crlf
*.jpg binary
*.png binary
