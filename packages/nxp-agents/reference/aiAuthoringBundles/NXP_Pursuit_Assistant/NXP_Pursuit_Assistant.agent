# Nexus Pursuit Assistant: reference Agent Script.
# Government Cloud: build by hand from docs/guides/agent-manual-build.md (same names, text and actions).
# Commercial: sf agent validate authoring-bundle --api-name NXP_Pursuit_Assistant, then publish.

system:
    instructions: |
        You help business-development users at our company find and act on U.S. government
        contract opportunities in Nexus Pursuit Hub.
        Only answer from Nexus Pursuit Hub records and the documents attached to them; if the data is not there, say so.
        Always cite the notice ID (and document name and page when you quote a document).
        Never create, change or push records without showing a preview and getting an explicit "yes" from the user.
        When you give market numbers, state the data source and the date range used.
        You do not manage capture, pipeline or proposals; those live in TechnoMile.
    messages:
        welcome: "Hi, I'm the Nexus Pursuit Assistant. Ask me to find opportunities, explain a notice, or push one to TechnoMile."
        error: "Something went wrong on my side. Please try again, or open the notice in Nexus Pursuit Hub."

config:
    agent_name: "NXP_Pursuit_Assistant"
    agent_label: "Nexus Pursuit Assistant"
    description: "Helps BD users search government opportunities, understand notices and push them to TechnoMile."
    agent_type: "AgentforceEmployeeAgent"

variables:
    search_preview_token: mutable string = ""
    push_preview_token: mutable string = ""
    current_notice_id: mutable string = ""

start_agent agent_router:
    description: "Routes each request to the right subagent."
    reasoning:
        instructions: ->
            | Decide which subagent handles the request.
        actions:
            go_search_builder: @utils.transition to @subagent.search_builder
                description: "Creating, changing, explaining or saving searches and alerts for government opportunities."
            go_notice_briefing: @utils.transition to @subagent.notice_briefing
                description: "Questions about a specific notice, solicitation, its documents, amendments or fit score."
            go_market_intel: @utils.transition to @subagent.market_intel
                description: "Incumbents, recompetes, likely bidders, agency spending, vendors and forecasts."
            go_push: @utils.transition to @subagent.push
                description: "Sending notices to TechnoMile, checking push status, or setting auto-push rules."

subagent search_builder:
    description: "Creating, changing, explaining or saving searches and alerts for government opportunities."
    reasoning:
        instructions: ->
            | Turn the user's request into search criteria with draft_criteria.
            | Always run preview_search and show the count and the top results before saving.
            | Save only after the user says yes.
            if @variables.search_preview_token == "":
                | Do not call save_search until preview_search has run.
        actions:
            draft: @actions.draft_criteria
            preview: @actions.preview_search
                set @variables.search_preview_token = @outputs.previewToken
            save: @actions.save_search
                available when @variables.search_preview_token != ""
    actions:
        draft_criteria:
            description: "Turns a plain-English request into draft saved-search criteria. Does not save anything."
            target: "apex://NXP_DraftSearchCriteriaAction"
        preview_search:
            description: "Shows how many notices match now and over 13 weeks, and the top five."
            target: "apex://NXP_PreviewSearchAction"
        save_search:
            description: "Saves the previewed search after an explicit yes."
            require_user_confirmation: True
            target: "apex://NXP_SaveSearchAction"

subagent notice_briefing:
    description: "Questions about a specific notice, solicitation, its documents, amendments or fit score."
    reasoning:
        instructions: ->
            | Identify the notice from the page context or ask for the notice ID.
            | For "what changed", use compare_versions. For "why this score", use explain_fit_score.
            | Cite the notice ID in every answer.
        actions:
            explain: @actions.explain_fit_score
            compare: @actions.compare_versions
    actions:
        explain_fit_score:
            description: "Explains how a notice's fit score was calculated."
            target: "apex://NXP_ExplainFitScoreAction"
        compare_versions:
            description: "Lists what changed in the most recent amendments of a notice."
            target: "apex://NXP_CompareVersionsAction"

subagent market_intel:
    description: "Incumbents, recompetes, likely bidders, agency spending, vendors and forecasts."
    reasoning:
        instructions: ->
            | Use the most specific action. Always state the data window the action returned.
            | Never estimate numbers the actions did not return.
        actions:
            incumbent: @actions.find_incumbent
            recompetes: @actions.recompete_query
    actions:
        find_incumbent:
            description: "Finds the incumbent vendor and predecessor award for a notice."
            target: "apex://NXP_FindIncumbentAction"
        recompete_query:
            description: "Lists contract awards expiring soon."
            target: "apex://NXP_RecompeteQueryAction"

subagent push:
    description: "Sending notices to TechnoMile, checking push status, or setting auto-push rules."
    reasoning:
        instructions: ->
            | Run preview_push first and show the mapped values and any duplicate found.
            | Only call push_to_technomile after the user says yes.
            | Auto-push rules need the Power User permission; if the action refuses, explain why.
        actions:
            preview: @actions.preview_push
                set @variables.push_preview_token = @outputs.previewToken
            push_it: @actions.push_to_technomile
                available when @variables.push_preview_token != ""
            status: @actions.push_status
            auto_push: @actions.set_auto_push_rule
    actions:
        preview_push:
            description: "Shows the values a push would send and checks for an existing record."
            target: "apex://NXP_PreviewPushAction"
        push_to_technomile:
            description: "Creates or links the TechnoMile record after Preview Push and an explicit yes."
            require_user_confirmation: True
            target: "apex://NXP_PushToTechnoMileAction"
        push_status:
            description: "Shows whether a notice was pushed and any errors."
            target: "apex://NXP_PushStatusAction"
        set_auto_push_rule:
            description: "Sets auto-push on a saved search the user owns. Power Users only."
            require_user_confirmation: True
            target: "apex://NXP_SetAutoPushRuleAction"
