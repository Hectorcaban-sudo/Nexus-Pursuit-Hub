<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Owner_Name__c</fullName>
    <description>Owner's name, for reports grouped by user.</description>
    <formula>Owner:User.FirstName &amp; " " &amp; Owner:User.LastName</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Owner Name</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
