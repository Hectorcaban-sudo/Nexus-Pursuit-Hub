    <externalSharingModel>Private</externalSharingModel>
    <label>Setting Change</label>
    <nameField>
        <displayFormat>SC-{0000000}</displayFormat>
        <label>Setting Change</label>
        <type>AutoNumber</type>
    </nameField>
