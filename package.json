{
    "name": "nexus-pursuit-hub",
    "private": true,
    "version": "1.0.0",
    "description": "Nexus Pursuit Hub: government opportunity intelligence on Salesforce (GovWin replacement) with push to Opportunity",
    "scripts": {
        "lint": "eslint \"packages/**/lwc/**/*.js\"",
        "test": "npm run test:unit",
        "test:unit": "sfdx-lwc-jest",
        "test:unit:coverage": "sfdx-lwc-jest --coverage",
        "prettier": "prettier --write \"**/*.{cls,trigger,js,html,json,md,xml,yaml,yml}\"",
        "prettier:verify": "prettier --check \"packages/**/*.{cls,trigger,js,html}\"",
        "prepare": "husky || true"
    },
    "devDependencies": {
        "@lwc/eslint-plugin-lwc": "^2.0.0",
        "@prettier/plugin-xml": "^3.4.1",
        "@salesforce/eslint-config-lwc": "^3.6.0",
        "@salesforce/eslint-plugin-lightning": "^1.0.0",
        "@salesforce/sfdx-lwc-jest": "^5.1.0",
        "eslint": "^8.57.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jest": "^28.6.0",
        "husky": "^9.1.4",
        "lint-staged": "^15.2.7",
        "prettier": "^3.3.3",
        "prettier-plugin-apex": "^2.1.4",
        "typescript": "^5.9.3"
    },
    "lint-staged": {
        "**/*.{cls,trigger,js,html,json,md,xml}": [
            "prettier --write"
        ],
        "**/lwc/**/*.js": [
            "eslint"
        ]
    }
}
