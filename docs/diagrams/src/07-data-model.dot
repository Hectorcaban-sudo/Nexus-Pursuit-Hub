digraph G {
  graph [fontname="DejaVu Sans", fontsize=20, labelloc=t, labeljust=l, pad=0.4, nodesep=0.45, ranksep=0.6, bgcolor="white", color="#C9CED6"];
  node  [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#8A96A8", fontcolor="#181818", margin="0.18,0.10"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#5C6B80", fontcolor="#3B4656", arrowsize=0.7];
  label="Data model (NXP_ prefix)\n";
  rankdir=LR;
  node [shape=plain, style="", fillcolor=""];
  edge [arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.8];
  "NXP_Gov_Notice__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#0B5CAB"><FONT COLOR="white"><B>NXP_Gov_Notice__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Notice_Id__c (ext id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Solicitation_Number__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Title__c, Notice_Type__c, Status__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">NAICS_Code__c, PSC_Code__c, Set_Aside__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Response_Due__c, Estimated_Value__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Fit_Score__c, AI_Summary__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Content_Hash__c, Version_Count__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Pushed__c, Pushed_Record_Id__c</FONT></TD></TR></TABLE>>];
  "NXP_Notice_Version__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Notice_Version__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Version_Number__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Change_Type__c, Changed_Fields__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Diff_Summary__c, AI_Change_Summary__c</FONT></TD></TR></TABLE>>];
  "NXP_Gov_Agency__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Gov_Agency__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Agency_Code__c (ext id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Parent_Agency__c, Level__c</FONT></TD></TR></TABLE>>];
  "NXP_Gov_Contact__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Gov_Contact__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Email__c, Phone__c, Role__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Contact_Key__c (ext id)</FONT></TD></TR></TABLE>>];
  "NXP_Gov_Vendor__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Gov_Vendor__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">UEI__c (ext id), CAGE_Code__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Business_Size__c, Socio_Economic__c</FONT></TD></TR></TABLE>>];
  "NXP_Award_Summary__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Award_Summary__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">PIID__c (ext id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Obligated_Amount__c, Period_End__c</FONT></TD></TR></TABLE>>];
  "NXP_Gov_Forecast__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Gov_Forecast__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Forecast_Id__c (ext id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Estimated_Solicitation_Date__c</FONT></TD></TR></TABLE>>];
  "NXP_Contract_Vehicle__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Contract_Vehicle__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Vehicle_Code__c (ext id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Inbox_Address__c, We_Hold__c</FONT></TD></TR></TABLE>>];
  "NXP_Saved_Search__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Saved_Search__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Criteria_JSON__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Alert_Frequency__c, Channels__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Visibility__c, Auto_Push__c</FONT></TD></TR></TABLE>>];
  "NXP_Search_Match__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Search_Match__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Match_Key__c (ext id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Alert_Status__c, User_Action__c</FONT></TD></TR></TABLE>>];
  "NXP_Follow__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Follow__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Follow_Key__c (ext id)</FONT></TD></TR></TABLE>>];
  "NXP_Push_Log__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Push_Log__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Status__c, Mode__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Target_Record_Id__c</FONT></TD></TR></TABLE>>];
  "NXP_Feed_Run__c" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8A96A8" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#032D60"><FONT COLOR="white"><B>NXP_Feed_Run__c</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Feed_Name__c, Channel__c, Status__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">counts, Checkpoint__c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">Idempotency_Key__c</FONT></TD></TR></TABLE>>];
  "NXP_Gov_Notice__c" -> "NXP_Notice_Version__c" [label="master-detail"];
  "NXP_Gov_Agency__c" -> "NXP_Gov_Notice__c" [label=""];
  "NXP_Gov_Notice__c" -> "NXP_Gov_Contact__c" [label=""];
  "NXP_Contract_Vehicle__c" -> "NXP_Gov_Notice__c" [label=""];
  "NXP_Gov_Forecast__c" -> "NXP_Gov_Notice__c" [label="matched"];
  "NXP_Award_Summary__c" -> "NXP_Gov_Notice__c" [label="predecessor"];
  "NXP_Gov_Vendor__c" -> "NXP_Award_Summary__c" [label=""];
  "NXP_Gov_Vendor__c" -> "NXP_Gov_Notice__c" [label="incumbent"];
  "NXP_Gov_Agency__c" -> "NXP_Award_Summary__c" [label=""];
  "NXP_Saved_Search__c" -> "NXP_Search_Match__c" [label="master-detail"];
  "NXP_Gov_Notice__c" -> "NXP_Search_Match__c" [label=""];
  "NXP_Gov_Notice__c" -> "NXP_Follow__c" [label=""];
  "NXP_Gov_Notice__c" -> "NXP_Push_Log__c" [label=""];
  mdt [shape=box, style="rounded,filled", fillcolor="#FFF8E6", label="Custom metadata types\nNXP_Feed_Config · NXP_Feed_Mapping · NXP_Fit_Rule\nNXP_Push_Mapping · NXP_Setting"];
}
